# ==============================================================================
# Caddyfile - Jungle Media Downloader
# Flow: User -> Cloudflare -> Caddy (this file) -> Flask app (app:5000)
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL OPTIONS
# ------------------------------------------------------------------------------
{
    # Caddy admin API off (attack surface kammi)
    admin off

    # Let's Encrypt cert expiry/notice emails
    email {$ACME_EMAIL:admin@localhost}

    # JSON logs to stdout (docker logs la paakkalam)
    log {
        output stdout
        format json
        level INFO
    }

    servers {
        # Indha IPs-la irundhu vara requests mattum Cloudflare nu Caddy nambum.
        # Appo thaan CF-Connecting-IP header la irukkura "real user IP" ah
        # Caddy accept pannum. Vera yaaravathu fake header anuppina ignore aagum.
        # (Cloudflare CIDRs maarum: https://www.cloudflare.com/ips-v4 and /ips-v6)
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

        # Trusted proxy kitta irundhu vandha request la, edhu la real IP irukku nu sollurom
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# ------------------------------------------------------------------------------
# SNIPPET: security headers (site block la "import security_headers")
# ------------------------------------------------------------------------------
(security_headers) {
    header {
        # Browser content-type guess pannaama thadukkum
        X-Content-Type-Options "nosniff"
        # Vera sites un page ah iframe la podaama thadukkum
        X-Frame-Options "SAMEORIGIN"
        # Other sites ku full URL leak aagaama
        Referrer-Policy "strict-origin-when-cross-origin"
        # Camera/mic/location block
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Server: Caddy header remove
        -Server
    }
}

# ------------------------------------------------------------------------------
# MAIN SITE
# SITE_ADDRESS env la irundhu varum (example: example.com). Illana localhost.
# Domain kuduthaa Caddy thaanaaga HTTPS cert eduthukkum.
# ------------------------------------------------------------------------------
{$SITE_ADDRESS:localhost} {
    import security_headers

    # Text/JSON/JS mattum compress. Video/audio compress pannaadhu (waste CPU).
    encode zstd gzip {
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type image/svg+xml*
        }
    }

    # Request body max 10MB (periya payload anuppi abuse pannaama)
    request_body {
        max_size 10MB
    }

    # /metrics public ku block. Internal ah paaka:
    #   docker compose exec app curl -s localhost:5000/metrics
    @blocked_metrics path /metrics /metrics/*
    respond @blocked_metrics 403 {
        body "403 Forbidden"
        close
    }

    # Static files (css/js/images) browser 30 naal cache pannum.
    # "immutable" ku bodhu simple cache, app.css maathina stuck aagaadhu.
    @static path /static/*
    header @static Cache-Control "public, max-age=2592000"

    # --------------------------------------------------------------------------
    # STREAMING ROUTES: video/audio download & preview
    # --------------------------------------------------------------------------
    @streaming path /api/stream /api/stream/* /api/preview /api/preview/*
    handle @streaming {
        reverse_proxy app:5000 {
            # Buffer pannaama bytes vandha udane user ku anuppu
            # (illana Caddy muzhu file ah memory la vechukkum)
            flush_interval -1

            # Verified real user IP ah app ku X-Real-IP ah anuppurom.
            # Cloudflare vazhiya vandha = CF-Connecting-IP, direct vandha = socket IP.
            # Caddy overwrite pannum, so user spoof panna mudiyaadhu.
            header_up X-Real-IP {client_ip}

            transport http {
                # Periya video ku 10 min varaikkum wait
                response_header_timeout 600s
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    # --------------------------------------------------------------------------
    # EVERYTHING ELSE: pages, /api/download, /api/sites ...
    # --------------------------------------------------------------------------
    handle {
        reverse_proxy app:5000 {
            header_up X-Real-IP {client_ip}

            transport http {
                # Chinna requests, 60s podhum
                response_header_timeout 60s
                read_timeout 60s
                write_timeout 60s
            }
        }
    }
}