# ==============================================================================
# Caddyfile - Jungle Media Downloader
# Traffic Flow: User -> Cloudflare (WAF/Edge) -> Caddy (this file) -> Flask app (app:5000)
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL OPTIONS
# ------------------------------------------------------------------------------
{
    # Disable Caddy admin API to reduce attack surface
    admin off

    # Let's Encrypt certificate registration and expiration notice email
    email {$ACME_EMAIL:admin@localhost}

    # JSON formatted structured access logs to stdout
    log {
        output stdout
        format json
        level INFO
    }

    servers {
        # Trust official Cloudflare IP ranges. Only when receiving traffic from these
        # CIDRs will Caddy parse the real user IP from CF-Connecting-IP / X-Forwarded-For.
        # Direct non-Cloudflare spoofed headers are rejected.
        # Up-to-date CIDRs: https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

        # Client IP header resolution order
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# ------------------------------------------------------------------------------
# SNIPPET: Standard Security Headers
# ------------------------------------------------------------------------------
(security_headers) {
    header {
        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking / unauthorized framing
        X-Frame-Options "SAMEORIGIN"
        # Preserve privacy on external navigations
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict dangerous browser features
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Remove server identification header
        -Server
    }
}

# ------------------------------------------------------------------------------
# MAIN APPLICATION SITE
# Resolved from SITE_ADDRESS (e.g. example.com) or defaults to localhost.
# Automatic HTTPS certificate managed via Let's Encrypt / ZeroSSL.
# ------------------------------------------------------------------------------
{$SITE_ADDRESS:localhost} {
    import security_headers

    # Compress textual and JSON payloads; do not compress already-compressed audio/video
    encode zstd gzip {
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type image/svg+xml*
        }
    }

    # Restrict maximum incoming request body to prevent payload exhaustion
    request_body {
        max_size 10MB
    }

    # Restrict /metrics endpoint from public access
    # Internal health and metrics access via container loopback only
    @blocked_metrics path /metrics /metrics/*
    handle @blocked_metrics {
        respond 403 {
            body "403 Forbidden"
            close
        }
    }

    # Static file caching with validation
    @static path /static/*
    header @static Cache-Control "public, max-age=3600, must-revalidate"

    # --------------------------------------------------------------------------
    # STREAMING ROUTES: Unbuffered video/audio downloads & live previews
    # --------------------------------------------------------------------------
    @streaming path /api/stream /api/stream/* /api/preview /api/preview/*
    handle @streaming {
        reverse_proxy app:5000 {
            # Disable buffering: flush bytes immediately to prevent Caddy memory saturation
            flush_interval -1

            # Pass validated client IP to Gunicorn
            header_up X-Real-IP {client_ip}

            transport http {
                # Extended timeout for long-running media streams (up to 10 minutes)
                response_header_timeout 600s
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    # --------------------------------------------------------------------------
    # GENERAL ROUTES: UI pages, /api/download metadata extraction, /healthz
    # --------------------------------------------------------------------------
    handle {
        reverse_proxy app:5000 {
            header_up X-Real-IP {client_ip}

            transport http {
                response_header_timeout 60s
                read_timeout 600s
                write_timeout 60s
            }
        }
    }
}

