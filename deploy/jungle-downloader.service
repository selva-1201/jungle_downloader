[Unit]
Description=Jungle Media Downloader Stack (Docker Compose)
Documentation=https://github.com/selva-mern12/jungle_downloader
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jungle_downloader

# Verify compose syntax and ensure containers start smoothly
ExecStart=/usr/bin/docker compose up --remove-orphans

# Graceful shutdown of services on service stop or system shutdown
ExecStop=/usr/bin/docker compose down --timeout 25

# Reload support
ExecReload=/usr/bin/docker compose restart

# Resilience and restart policies
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jungle-downloader

[Install]
WantedBy=multi-user.target

